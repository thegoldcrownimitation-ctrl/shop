# =================================================================
# The Gold Crown — Headless Storefront Environment Variables
# =================================================================

# 1. Shopify Storefront API (Existing Storefront Access)
# -----------------------------------------------------------------
# Your Shopify store domain (e.g. your-store.myshopify.com)
VITE_SHOPIFY_STORE_DOMAIN=thegoldcrownimitation.myshopify.com

# Public Storefront API token from Shopify Admin:
#   Sales Channels -> Headless -> <Storefront> -> Storefront API credentials
VITE_SHOPIFY_STOREFRONT_TOKEN=your_public_storefront_access_token_here

# 2. Shopify Customer Account API (Modern OAuth 2.0 PKCE Authentication)
# -----------------------------------------------------------------
# Client ID generated in Shopify Admin:
#   Settings -> Customer Accounts -> Customer Account API -> Credentials
#   (or Sales Channels -> Headless -> Customer Account API)
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=your_customer_account_client_id_here

# Optional: Client Secret (only required if configured as a Confidential Client)
# Leave blank for Public Client (PKCE S256 flow)
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_SECRET=

# Optional: Custom OAuth Redirect Callback URI
# (Defaults automatically to <origin>/api/auth/callback)
# Example for production: https://www.thegoldcrownjewellery.com/api/auth/callback
# Example for local development: http://localhost:8080/api/auth/callback
SHOPIFY_CUSTOMER_ACCOUNT_REDIRECT_URI=

# Optional: Custom Post-Logout Redirect URI
# (Defaults automatically to <origin>/)
SHOPIFY_CUSTOMER_ACCOUNT_LOGOUT_REDIRECT_URI=

# 3. Session Security
# -----------------------------------------------------------------
# 32+ character random secret used to sign and encrypt session cookies
SESSION_SECRET=your_random_32_character_session_secret_here

# 4. Deployment Preset (Vercel)
# -----------------------------------------------------------------
NITRO_PRESET=vercel
